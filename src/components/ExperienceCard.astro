---
interface Props {
	date: string;
	role: string;
	company: string;
	companyDesc: string;
	workType?: string;
	techStack: string[];
	description: string;
	projectName?: string;
	timelineColor?: 'accent' | 'indigo' | 'text-primary';
}

const { 
	date, role, company, companyDesc, workType, techStack, 
	description, projectName, timelineColor = 'text-primary' 
} = Astro.props;

// Map timeline colors to CSS classes
const timelineColors = {
	accent: 'bg-accent',
	indigo: 'bg-indigo', 
	'text-primary': 'bg-text-primary'
};

// Simple utility function to combine classes
function cn(...classes: (string | boolean | undefined)[]) {
	return classes.filter(Boolean).join(' ');
}
---

<div class="flex gap-0 mb-8">
	<div class={`w-1 shrink-0 ${timelineColors[timelineColor]}`}></div>
	<div class="border-[3px] border-text-primary bg-bg-secondary shadow-[6px_6px_0_var(--color-black)] flex-1">
		<div class="p-6">
			<div class="flex items-baseline gap-4 mb-3">
				<span class="font-['Space_Grotesk'] font-bold text-md text-indigo">{date}</span>
				{workType && (
					<span class="text-lg font-bold bg-text-primary text-white px-2 py-1">{workType}</span>
				)}
			</div>
			<p class="font-semibold text-xl mb-1">{role}</p>
			<div class="flex items-center gap-4 mb-2">
				<h3 class="font-['Space_Grotesk'] font-bold text-lg">{company}</h3>
				<p class="text-md text-gray-600">{companyDesc}</p>
			</div>
			<div class="flex flex-wrap gap-2 mb-4">
				{techStack.map(tech => (
					<span class="px-3 py-1 border-2 border-text-primary text-text-primary font-['Space_Mono'] text-sm font-medium">
						{tech}
					</span>
				))}
			</div>
			<p class="mt-4">{description}</p>
			{projectName && (
				<p class="mt-4"><strong>{projectName}</strong></p>
			)}
			<slot name="items" />
		</div>
	</div>
</div>