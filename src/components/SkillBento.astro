---
interface Props {
	title: string;
	isLarge?: boolean;
	isDashed?: boolean;
	span?: number;
}

const { title, isLarge = false, isDashed = false, span = 1 } = Astro.props;

// Simple utility function to combine classes
function cn(...classes: (string | boolean | undefined)[]) {
	return classes.filter(Boolean).join(' ');
}
---

<div
	class={cn(
		"border-[3px] border-text-primary p-6 shadow-[6px_6px_0_var(--color-black)]",
		isLarge ? "bg-text-primary text-white" : "bg-bg-secondary",
		isDashed && "border-dashed",
		span > 1 ? `md:col-span-2` : `md:col-span-1`
	)}
>
	<p class="text-xs font-bold mb-4 opacity-70">{title}</p>
	<div class="text-xl md:text-2xl font-bold leading-tight space-y-1 [&>div]:grid [&>div]:grid-cols-2 [&>div]:gap-2">
		<slot />
	</div>
</div>